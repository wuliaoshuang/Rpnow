{
    "name": "rpnow",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "description": "RPNow — AI roleplay tavern with a fully pluggable core",
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "dev:desktop": "tauri dev",
        "build:desktop": "tauri build",
        "build:desktop:exe": "tauri build --no-bundle",
        "build:desktop:nsis": "tauri build --bundles nsis",
        "build:desktop:msi": "tauri build --bundles msi",
        "icons": "node scripts/make-icons.mjs",
        "test:smoke": "node scripts/smoke.mjs",
        "test:chat": "node scripts/chat-e2e.mjs",
        "test:plugin": "node scripts/plugin-e2e.mjs",
        "test:rpnx": "node scripts/rpnx-e2e.mjs",
        "test:prod": "node scripts/prod-check.mjs",
        "test:desktop": "node scripts/desktop-e2e.mjs",
        "test:installed": "node scripts/installed-e2e.mjs",
        "test:cors": "node scripts/cors-bypass-e2e.mjs",
        "test:pwa": "node scripts/pwa-e2e.mjs",
        "tauri": "tauri",
        "build:android": "node scripts/android-env.mjs tauri android build --apk --split-per-abi --target aarch64",
        "build:android:all": "node scripts/android-env.mjs tauri android build --apk --split-per-abi",
        "build:android:debug": "node scripts/android-env.mjs tauri android build --apk --debug",
        "dev:android": "node scripts/android-env.mjs tauri android dev",
        "test:android": "node scripts/android-functional.mjs",
        "test:android:release": "node scripts/android-release-check.mjs",
        "build:plugin": "node scripts/build-plugin.mjs",
        "test:tts": "node scripts/tts-e2e.mjs",
        "test:plugin-settings": "node scripts/plugin-settings-e2e.mjs",
        "test:realdevice": "node scripts/realdevice-check.mjs"
    },
    "dependencies": {
        "@radix-ui/react-accordion": "^1.3.1",
        "@radix-ui/react-checkbox": "^1.4.1",
        "@radix-ui/react-dialog": "^1.3.1",
        "@radix-ui/react-dropdown-menu": "^2.2.1",
        "@radix-ui/react-label": "^2.1.17",
        "@radix-ui/react-popover": "^1.3.1",
        "@radix-ui/react-progress": "^1.2.1",
        "@radix-ui/react-scroll-area": "^1.4.0",
        "@radix-ui/react-select": "^2.4.1",
        "@radix-ui/react-separator": "^1.2.0",
        "@radix-ui/react-slider": "^1.6.1",
        "@radix-ui/react-slot": "^1.5.0",
        "@radix-ui/react-switch": "^1.4.1",
        "@radix-ui/react-tabs": "^1.2.1",
        "@radix-ui/react-tooltip": "^1.4.1",
        "@tailwindcss/vite": "^4.3.5",
        "@tauri-apps/api": "^2.12.4",
        "@tauri-apps/plugin-http": "^2.9.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "dompurify": "^3.4.17",
        "es-module-lexer": "^1.5.4",
        "idb-keyval": "^6.3.0",
        "jszip": "^3.10.2",
        "lucide-react": "^1.72.0",
        "marked": "^18.2.0",
        "nanoid": "^6.0.2",
        "pako": "^3.0.3",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "react-markdown": "^10.1.0",
        "rehype-raw": "^7.0.0",
        "rehype-sanitize": "^6.0.0",
        "remark-gfm": "^4.0.1",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.5",
        "tw-animate-css": "^1.4.0",
        "yaml": "^2.9.1",
        "zustand": "^5.1.0"
    },
    "devDependencies": {
        "@tauri-apps/cli": "^2.12.4",
        "@types/node": "^26.6.6",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^5.0.0",
        "playwright": "^1.65.0",
        "typescript": "^5.9.0",
        "vite": "^7.1.0",
        "vite-plugin-pwa": "^2.0.0",
        "vitest": "^3.2.0",
        "ws": "^8.23.0"
    }
}
