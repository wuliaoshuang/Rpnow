{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "RPNow",
  "version": "0.1.0",
  "identifier": "app.rpnow.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "RPNow",
        "width": 1280,
        "height": 820,
        "minWidth": 380,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "theme": null,
        "backgroundColor": "#1a1520"
      }
    ],
    "security": {
      "dangerousDisableAssetCspModification": ["script-src", "style-src"],
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' data: blob: https: http: asset: http://asset.localhost",
        "media-src": "'self' data: blob: https: http:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self' blob: 'unsafe-eval' 'unsafe-inline'",
        "connect-src": "'self' ipc: http://ipc.localhost https: http: data: blob:",
        "font-src": "'self' data:",
        "frame-src": "'self' data: blob:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "RPNow",
    "category": "Entertainment",
    "shortDescription": "AI 角色扮演酒馆",
    "longDescription": "RPNow — 专注于 AI 角色扮演的本地优先应用，支持角色卡 / 世界书 / 预设导入与插件化扩展。",
    "copyright": "RPNow",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
